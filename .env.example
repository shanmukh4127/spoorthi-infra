# Copy to .env (ignored by Git). Generate your own password hash with npm run admin:hash.
SPOORTHI_ADMIN_USERNAME=
SPOORTHI_ADMIN_PASSWORD_HASH=
# Local full-stack app: http://localhost:3001
# npm run dev starts Vite and its local data service together; no second process is needed.
# Without administrator values, public viewing works and admin sign-in stays disabled.
PUBLIC_ORIGIN=http://localhost:3001
HOST=127.0.0.1
PORT=3001
SPOORTHI_DATA_DIR=./storage
# Production requires PUBLIC_ORIGIN=https://your-domain and TLS at a reverse proxy.
NODE_ENV=development
